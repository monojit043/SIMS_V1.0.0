# SIMS — Special Items Management System (port 5000)
PORT=5000
NODE_ENV=development

# SIMS' own database (P&ID copies + highlights, special item tags, ST6 reports, library tasks)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=SIMS_V1.0
PGUSER=postgres
PGPASSWORD=

# ePULSE (read-only, live): logins via its PC-2 link, jobs/units/GL/SGL, line list, P&ID module
EPULSE_DB_HOST=localhost
EPULSE_DB_PORT=5432
EPULSE_DB_NAME=ePULSE_DEV_v1.0.0
EPULSE_DB_USER=postgres
EPULSE_DB_PASSWORD=
# ePULSE's uploads folder (P&ID PDFs are copied from here for highlighting)
EPULSE_UPLOADS_ROOT=D:\ePULSE_DEV_v1.0.0\backend\uploads

# IPMCS (read-only, live): the IPMCS team of each job + unit = who may use SIMS there
IPMCS_DB_HOST=localhost
IPMCS_DB_PORT=5432
IPMCS_DB_NAME=IPMCS_UTILITY_1.0
IPMCS_DB_USER=postgres
IPMCS_DB_PASSWORD=

# SIMS session token
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Single sign-on with ePULSE / MRCS / SSMS / IPMCS — must be identical in every app
SSO_SECRET=

CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
