# SIMS v1.0.0 — PRODUCTION settings (office apps server, next to ePULSE and IPMCS)
# This file becomes  BACKEND\.env  (apply_update.bat copies it there on the first install).
# Fill every <...>. Never commit BACKEND\.env.
PORT=5000
NODE_ENV=production
# Only create missing tables at start; column changes happen in apply_update.bat (after a backup)
DB_SYNC=create

# ── SIMS' own database on this server (step1_setup_database.bat creates it) ──
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=SIMS_V1.0
PGUSER=postgres
PGPASSWORD=<postgres password of this server>

# ── ePULSE (read-only, live): logins via its PIMS-server link, jobs/units, line list, P&IDs ──
EPULSE_DB_HOST=localhost
EPULSE_DB_PORT=5432
EPULSE_DB_NAME=ePULSE_v1.0.0
EPULSE_DB_USER=postgres
EPULSE_DB_PASSWORD=<postgres password of this server>
# ePULSE's uploads folder (P&ID PDFs are copied from here for highlighting)
EPULSE_UPLOADS_ROOT=E:\ePULSE_v1.0.0\backend\uploads

# ── IPMCS (read-only, live): the IPMCS team of each job + unit = who may use SIMS there ──
IPMCS_DB_HOST=localhost
IPMCS_DB_PORT=5432
IPMCS_DB_NAME=IPMCS_UTILITY_1.0
IPMCS_DB_USER=postgres
IPMCS_DB_PASSWORD=<postgres password of this server>

# Session token — left empty, step 1 writes a new random value here
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Single sign-on — EXACTLY the SSO_SECRET of E:\ePULSE_v1.0.0\backend\.env
SSO_SECRET=<same as ePULSE>

# The pages are served by SIMS itself (same address), so no other origins are needed
CORS_ORIGIN=
